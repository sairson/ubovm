  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#92958D", "fontStyle": "italic" }
    },
    {
      "name": "Keywords and storage",
      "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#86618A" }
    },
    {
      "name": "Operators and punctuation",
      "scope": ["keyword.operator", "punctuation", "meta.brace"],
      "settings": { "foreground": "#747578" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#65815C" }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant.numeric", "constant.language", "constant.character", "variable.other.constant", "entity.name.constant"],
      "settings": { "foreground": "#A47A45" }
    },
    {
      "name": "Functions and methods",
      "scope": ["entity.name.function", "support.function", "variable.function"],
      "settings": { "foreground": "#557B94" }
    },
    {
      "name": "Classes and types",
      "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "support.class", "support.type"],
      "settings": { "foreground": "#4F8580" }
    },
    {
      "name": "Variables and parameters",
      "scope": ["variable", "variable.parameter", "meta.definition.variable", "meta.object-literal.key"],
      "settings": { "foreground": "#494A4C" }
    },
    {
      "name": "Language variables",
      "scope": ["variable.language"],
      "settings": { "foreground": "#86618A" }
    },
    {
      "name": "Properties",
      "scope": ["variable.other.property", "support.variable.property", "support.type.property-name", "entity.other.attribute-name"],
      "settings": { "foreground": "#92724B" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#557B94" }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": ["constant.character.escape", "string.regexp", "keyword.other.template"],
      "settings": { "foreground": "#9A7266" }
    },
    {
      "name": "JSON property names",
      "scope": ["support.type.property-name.json", "support.type.property-name.json.comments"],
      "settings": { "foreground": "#557B94" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": { "foreground": "#14161A", "fontStyle": "bold" }
    },
    {
      "name": "Markdown emphasis",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markdown strong emphasis",
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link", "meta.link.inline"],
      "settings": { "foreground": "#3E56BE" }
    },
    {
      "name": "Markdown inline code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#65815C" }
    },
    {
      "name": "Diff additions",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#63866A" }
    },
    {
      "name": "Diff deletions and invalid code",
      "scope": ["markup.deleted", "invalid", "invalid.illegal"],
      "settings": { "foreground": "#B44A46" }
    },
    {
      "name": "Diff changed lines",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#A47A45" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#4F8580",
    "type": "#4F8580",
    "class": "#4F8580",
    "interface": "#4F8580",
    "enum": "#4F8580",
    "typeParameter": "#4F8580",
    "function": "#557B94",
    "method": "#557B94",
    "property": "#92724B",
    "variable": "#494A4C",
    "parameter": "#494A4C",
    "variable.readonly": "#A47A45",
    "enumMember": "#A47A45",
    "keyword": "#86618A",
    "string": "#65815C",
    "number": "#A47A45",
    "regexp": "#9A7266",
    "comment": { "foreground": "#92958D", "italic": true }
  }
}
