  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment", "punctuation.definition.quote.begin.markdown"],
      "settings": { "foreground": "#8A93A0", "fontStyle": "italic" }
    },
    {
      "name": "Keywords and storage",
      "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#C4A0CB" }
    },
    {
      "name": "Operators and punctuation",
      "scope": ["keyword.operator", "punctuation", "meta.brace", "punctuation.definition.list.begin.markdown"],
      "settings": { "foreground": "#9EA3AB" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template", "meta.embedded.assembly"],
      "settings": { "foreground": "#9FBE9A" }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other.option", "variable.other.constant", "variable.other.enummember", "entity.name.constant", "keyword.operator.plus.exponent", "keyword.operator.minus.exponent"],
      "settings": { "foreground": "#D6B17A" }
    },
    {
      "name": "Functions and methods",
      "scope": ["entity.name.function", "support.function", "variable.function", "support.constant.handlebars", "source.powershell variable.other.member", "entity.name.operator.custom-literal"],
      "settings": { "foreground": "#92B7D6" }
    },
    {
      "name": "Classes and types",
      "scope": ["support.class", "support.type", "entity.name.type", "entity.name.class", "entity.name.namespace", "entity.name.scope-resolution", "storage.type.numeric.go", "storage.type.byte.go", "storage.type.boolean.go", "storage.type.string.go", "storage.type.uintptr.go", "storage.type.error.go", "storage.type.rune.go", "storage.type.cs", "storage.type.generic.cs", "storage.type.modifier.cs", "storage.type.variable.cs", "storage.type.annotation.java", "storage.type.generic.java", "storage.type.java", "storage.type.object.array.java", "storage.type.primitive.array.java", "storage.type.primitive.java", "storage.type.token.java", "storage.type.groovy", "storage.type.annotation.groovy", "storage.type.parameters.groovy", "storage.type.generic.groovy", "storage.type.object.array.groovy", "storage.type.primitive.array.groovy", "storage.type.primitive.groovy"],
      "settings": { "foreground": "#7FC0B8" }
    },
    {
      "name": "Variables and parameters",
      "scope": ["variable", "variable.parameter", "meta.definition.variable", "meta.definition.variable.name", "support.variable", "entity.name.variable", "constant.other.placeholder", "meta.object-literal.key"],
      "settings": { "foreground": "#D8DADF" }
    },
    {
      "name": "Language variables",
      "scope": ["variable.language"],
      "settings": { "foreground": "#C4A0CB" }
    },
    {
      "name": "Properties",
      "scope": ["variable.other.property", "support.variable.property", "support.type.property-name", "support.type.vendored.property-name", "entity.other.attribute-name", "entity.other.attribute", "meta.structure.dictionary.key.python", "source.css variable", "source.coffee.embedded"],
      "settings": { "foreground": "#C7A97C" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#92B7D6" }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": ["constant.character.escape", "string.regexp", "keyword.other.template"],
      "settings": { "foreground": "#E08A84" }
    },
    {
      "name": "JSON property names",
      "scope": ["support.type.property-name.json", "support.type.property-name.json.comments"],
      "settings": { "foreground": "#C7A97C" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section.markdown", "header"],
      "settings": { "foreground": "#ECEDEF", "fontStyle": "bold" }
    },
    {
      "name": "Markdown emphasis",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#C4A0CB", "fontStyle": "italic" }
    },
    {
      "name": "Markdown strong emphasis",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#E8EBF0", "fontStyle": "bold" }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link", "meta.link.inline"],
      "settings": { "foreground": "#A8BADF" }
    },
    {
      "name": "Markdown inline code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#9FBE9A" }
    },
    {
      "name": "Diff additions",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#6FBE8E" }
    },
    {
      "name": "Diff deletions and invalid code",
      "scope": ["markup.deleted", "invalid", "invalid.illegal"],
      "settings": { "foreground": "#E08A84" }
    },
    {
      "name": "Diff changed lines",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#D6B17A" }
    },
    {
      "name": "Embedded language resets",
      "scope": ["meta.embedded", "source.groovy.embedded", "string meta.image.inline.markdown", "variable.legacy.builtin.python", "meta.template.expression"],
      "settings": { "foreground": "#D8DADF" }
    },
    {
      "name": "Template expression punctuation",
      "scope": ["punctuation.definition.template-expression.begin", "punctuation.definition.template-expression.end", "punctuation.section.embedded", "punctuation.section.embedded.begin.php", "punctuation.section.embedded.end.php"],
      "settings": { "foreground": "#9EA3AB" }
    },
    {
      "name": "Preprocessor",
      "scope": ["meta.preprocessor", "entity.name.function.preprocessor", "meta.preprocessor.string", "meta.preprocessor.numeric"],
      "settings": { "foreground": "#C4A0CB" }
    },
    {
      "name": "Diff header",
      "scope": ["meta.diff.header"],
      "settings": { "foreground": "#A8BADF" }
    },
    {
      "name": "Regex constants and anchors",
      "scope": ["constant.regexp", "keyword.operator.or.regexp", "keyword.control.anchor.regexp", "keyword.operator.quantifier.regexp"],
      "settings": { "foreground": "#C7A97C" }
    },
    {
      "name": "Regex groups and character classes",
      "scope": ["punctuation.definition.group.regexp", "punctuation.definition.group.assertion.regexp", "punctuation.definition.character-class.regexp", "punctuation.character.set.begin.regexp", "punctuation.character.set.end.regexp", "keyword.operator.negation.regexp", "support.other.parenthesis.regexp", "constant.character.character-class.regexp", "constant.other.character-class.set.regexp", "constant.other.character-class.regexp", "constant.character.set.regexp"],
      "settings": { "foreground": "#E08A84" }
    },
    {
      "name": "CSS selectors and classes",
      "scope": ["entity.name.tag.css", "entity.name.tag.less", "entity.other.attribute-name.class.css", "source.css entity.other.attribute-name.class", "entity.other.attribute-name.id.css", "entity.other.attribute-name.parent-selector.css", "entity.other.attribute-name.parent.less", "source.css entity.other.attribute-name.pseudo-class", "entity.other.attribute-name.pseudo-element.css", "source.css.less entity.other.attribute-name.id", "entity.other.attribute-name.scss"],
      "settings": { "foreground": "#C7A97C" }
    },
    {
      "name": "CSS property values",
      "scope": ["support.constant.property-value", "support.constant.font-name", "support.constant.media-type", "support.constant.media", "constant.other.color.rgb-value", "constant.other.rgb-value", "support.constant.color"],
      "settings": { "foreground": "#C7A97C" }
    },
    {
      "name": "Control flow and special keywords",
      "scope": ["keyword.control", "source.cpp keyword.operator.new", "keyword.operator.delete", "keyword.other.using", "keyword.other.directive.using", "keyword.other.operator", "entity.name.operator"],
      "settings": { "foreground": "#C4A0CB" }
    },
    {
      "name": "Type declarations, TS specific",
      "scope": ["meta.type.cast.expr", "meta.type.new.expr", "support.constant.math", "support.constant.dom", "support.constant.json", "entity.other.inherited-class", "punctuation.separator.namespace.ruby"],
      "settings": { "foreground": "#7FC0B8" }
    },
    {
      "name": "Git rebase refs",
      "scope": ["support.function.git-rebase"],
      "settings": { "foreground": "#92B7D6" }
    },
    {
      "name": "Git rebase SHA",
      "scope": ["constant.sha.git-rebase"],
      "settings": { "foreground": "#D6B17A" }
    },
    {
      "name": "Java import identifiers",
      "scope": ["storage.modifier.import.java", "variable.language.wildcard.java", "storage.modifier.package.java"],
      "settings": { "foreground": "#D8DADF" }
    },
    {
      "name": "Units",
      "scope": ["keyword.other.unit"],
      "settings": { "foreground": "#D6B17A" }
    },
    {
      "name": "Labels",
      "scope": ["entity.name.label"],
      "settings": { "foreground": "#D8DADF" }
    },
    {
      "name": "Generic emphasis",
      "scope": ["emphasis"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Generic strong",
      "scope": ["strong"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Markdown underline",
      "scope": ["markup.underline"],
      "settings": { "fontStyle": "underline" }
    },
    {
      "name": "Markdown strikethrough",
      "scope": ["markup.strikethrough"],
      "settings": { "fontStyle": "strikethrough" }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#7FC0B8",
    "type": "#7FC0B8",
    "class": "#7FC0B8",
    "interface": "#7FC0B8",
    "enum": "#7FC0B8",
    "typeParameter": "#7FC0B8",
    "function": "#92B7D6",
    "method": "#92B7D6",
    "property": "#C7A97C",
    "variable": "#D8DADF",
    "parameter": "#D8DADF",
    "variable.readonly": "#D6B17A",
    "enumMember": "#D6B17A",
    "keyword": "#C4A0CB",
    "string": "#9FBE9A",
    "number": "#D6B17A",
    "regexp": "#C7A97C",
    "comment": { "foreground": "#8A93A0", "italic": true },
    "newOperator": "#C4A0CB",
    "stringLiteral": "#9FBE9A",
    "customLiteral": "#92B7D6",
    "numberLiteral": "#D6B17A"
  },
  "type": "dark"
}
