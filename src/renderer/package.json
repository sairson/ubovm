{
  "name": "ubovm-core",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.2.0",
  "publisher": "ubovm",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.135.0"
  },
  "enabledApiProposals": [
    "browser"
  ],
  "categories": [
    "Other"
  ],
  "main": "./extension.cjs",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "*",
    "onWebviewPanel:ubovm.welcome"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "ubovm.setupPythonSandbox",
        "title": "%command.setupPythonSandbox%",
        "category": "UBOVM"
      },
      {
        "command": "ubovm.expandFileEditor",
        "title": "%command.expandFileEditor%",
        "category": "UBOVM",
        "icon": "$(screen-full)",
        "enablement": "!editorPartMaximizedEditorGroup && multipleEditorGroups && activeEditor != mainThreadWebview-ubovm.welcome && activeEditor != mainThreadWebview-ubovm.conversation"
      },
      {
        "command": "ubovm.restoreFileEditor",
        "title": "%command.restoreFileEditor%",
        "category": "UBOVM",
        "icon": "$(screen-normal)",
        "enablement": "editorPartMaximizedEditorGroup"
      },
      {
        "command": "ubovm.validateCodeChanges",
        "title": "%command.validateCodeChanges%",
        "category": "UBOVM",
        "icon": "$(check-all)"
      },
      {
        "command": "ubovm.attachSelection",
        "title": "%command.attachSelection%",
        "category": "UBOVM",
        "icon": "$(comment-discussion)",
        "enablement": "editorHasSelection"
      },
      {
        "command": "ubovm.installBrowser",
        "title": "%command.installBrowser%",
        "category": "UBOVM",
        "icon": "$(cloud-download)"
      },
      {
        "command": "ubovm.openBrowser",
        "title": "%command.openBrowser%",
        "category": "UBOVM",
        "icon": "$(globe)"
      },
      {
        "command": "ubovm.reviewCodeChanges",
        "enablement": "ubovm.mode == assist",
        "title": "%command.reviewCodeChanges%",
        "category": "UBOVM",
        "icon": "$(diff)"
      },
      {
        "command": "ubovm.configureModel",
        "title": "%command.configureModel%",
        "category": "UBOVM",
        "icon": "$(settings-gear)"
      },
      {
        "command": "ubovm.runGoal",
        "title": "%command.runGoal%",
        "category": "UBOVM",
        "icon": "$(play)"
      },
      {
        "command": "ubovm.cancelRun",
        "title": "%command.cancelRun%",
        "category": "UBOVM",
        "icon": "$(debug-stop)"
      },
      {
        "command": "ubovm.resumeRun",
        "title": "%command.resumeRun%",
        "category": "UBOVM",
        "icon": "$(debug-continue)"
      },
      {
        "command": "ubovm.openWelcome",
        "title": "%command.openWelcome%",
        "category": "UBOVM",
        "icon": "$(home)"
      },
      {
        "command": "ubovm.openTerminal",
        "title": "%command.openTerminal%",
        "category": "UBOVM",
        "icon": "$(remote)"
      },
      {
        "command": "ubovm.openLocalTerminal",
        "title": "%command.openLocalTerminal%",
        "category": "UBOVM",
        "icon": "$(terminal)"
      },
      {
        "command": "ubovm.selectTerminal",
        "title": "%command.selectTerminal%",
        "category": "UBOVM",
        "icon": "$(list-selection)"
      },
      {
        "command": "ubovm.openSource",
        "title": "%command.openSource%",
        "category": "UBOVM",
        "icon": "$(code)"
      },
      {
        "command": "ubovm.showRuntimeInfo",
        "title": "%command.showRuntimeInfo%",
        "category": "UBOVM",
        "icon": "$(info)"
      },
      {
        "command": "ubovm.openAssistant",
        "title": "%command.openAssistant%",
        "category": "UBOVM",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "ubovm.newChat",
        "title": "%command.newChat%",
        "category": "UBOVM",
        "icon": "$(add)"
      },
      {
        "command": "ubovm.newGoal",
        "title": "%command.newGoal%",
        "category": "UBOVM",
        "icon": "$(add)"
      },
      {
        "command": "ubovm.showMoreSessions",
        "title": "%command.showMoreSessions%",
        "category": "UBOVM",
        "icon": "$(ellipsis)"
      },
      {
        "command": "ubovm.selectConversation",
        "title": "%command.selectConversation%",
        "category": "UBOVM",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "ubovm.deleteConversation",
        "title": "%command.deleteConversation%",
        "category": "UBOVM",
        "icon": "$(trash)"
      },
      {
        "command": "ubovm.resetLayout",
        "title": "%command.resetLayout%",
        "category": "UBOVM",
        "icon": "$(layout)"
      },
      {
        "command": "ubovm.searchConversations",
        "title": "%command.searchConversations%",
        "category": "UBOVM",
        "icon": "$(search)"
      },
      {
        "command": "ubovm.hideSessions",
        "title": "%command.hideSessions%",
        "category": "UBOVM",
        "icon": "$(chevron-left)"
      },
      {
        "command": "ubovm.hideFiles",
        "title": "%command.hideFiles%",
        "category": "UBOVM",
        "icon": "$(chevron-right)"
      },
      {
        "command": "ubovm.createFirstFile",
        "title": "%command.createFirstFile%",
        "category": "UBOVM",
        "icon": "$(new-file)"
      },
      {
        "command": "ubovm.openSettings",
        "title": "%command.openSettings%",
        "category": "UBOVM",
        "icon": "$(settings-gear)"
      },
      {
        "command": "ubovm.openMcp",
        "title": "%command.openMcp%",
        "category": "UBOVM",
        "icon": "$(plug)"
      },
      {
        "command": "ubovm.openSkills",
        "title": "%command.openSkills%",
        "category": "UBOVM",
        "icon": "$(book)"
      },
      {
        "command": "ubovm.toggleTheme",
        "title": "%command.toggleTheme%",
        "category": "UBOVM",
        "icon": "$(color-mode)"
      },
      {
        "command": "ubovm.reloadConversation",
        "title": "%command.reloadConversation%",
        "category": "UBOVM"
      },
      {
        "command": "ubovm.newProject",
        "title": "%command.newProject%",
        "category": "UBOVM",
        "icon": "$(new-folder)"
      },
      {
        "command": "ubovm.openProject",
        "title": "%command.openProject%",
        "category": "UBOVM",
        "icon": "$(folder-opened)"
      },
      {
        "command": "ubovm.manageProjects",
        "title": "%command.manageProjects%",
        "category": "UBOVM",
        "icon": "$(folder-opened)"
      },
      {
        "command": "ubovm.newProjectConversation",
        "title": "%command.newProjectConversation%",
        "category": "UBOVM",
        "icon": "$(add)"
      },
      {
        "command": "ubovm.changeProjectWorkspace",
        "title": "%command.changeProjectWorkspace%",
        "category": "UBOVM",
        "icon": "$(folder)"
      },
      {
        "command": "ubovm.renameProject",
        "title": "%command.renameProject%",
        "category": "UBOVM"
      },
      {
        "command": "ubovm.deleteProject",
        "title": "%command.deleteProject%",
        "category": "UBOVM",
        "icon": "$(trash)"
      }
    ],
    "terminal": {
      "profiles": [
        {
          "id": "ubovm.local",
          "title": "当前系统终端",
          "icon": "terminal"
        },
        {
          "id": "ubovm.ssh",
          "title": "UBOVM SSH",
          "icon": "remote"
        }
      ]
    },
    "configurationDefaults": {
      "security.workspace.trust.enabled": false,
      "json.schemaDownload.trustedDomains": {
        "*": true
      },
      "terminal.integrated.defaultProfile.windows": "当前系统终端",
      "terminal.integrated.defaultProfile.linux": "当前系统终端",
      "terminal.integrated.defaultProfile.osx": "当前系统终端",
      "workbench.editor.restoreEditors": false,
      "window.restoreWindows": "one",
      "files.hotExit": "onExit",
      "terminal.integrated.enablePersistentSessions": false,
      "workbench.startupEditor": "none"
    },
    "configuration": {
      "title": "UBOVM Agent",
      "properties": {
        "ubovm.modelProfiles": {
          "type": "array",
          "scope": "machine",
          "default": [],
          "description": "已保存的模型配置。请在系统配置中管理；API Key 保存在系统凭据库中。",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "model"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "model": {
                "type": "object"
              }
            }
          }
        },
        "ubovm.model": {
          "type": "object",
          "scope": "machine",
          "default": {},
          "markdownDescription": "对话、规划与任务执行默认使用的模型。使用 `UBOVM: 配置模型与 API 密钥` 将密钥保存到加密凭据存储。",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string",
              "description": "Pi Agent 使用的模型服务商标识。"
            },
            "modelId": {
              "type": "string",
              "description": "模型 ID。"
            },
            "api": {
              "type": "string",
              "description": "自定义服务的 pi API 类型，例如 openai-completions。"
            },
            "baseUrl": {
              "type": "string",
              "description": "自定义服务的 API 地址。"
            },
            "contextWindow": {
              "type": "integer",
              "minimum": 1
            },
            "maxTokens": {
              "type": "integer",
              "minimum": 1
            },
            "reasoning": {
              "type": "boolean"
            },
            "input": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "text",
                  "image"
                ]
              }
            },
            "compat": {
              "type": "object",
              "description": "pi provider 的兼容性参数。"
            },
            "streamOptions": {
              "type": "object",
              "description": "请求超时、重试和采样参数。"
            }
          }
        },
        "ubovm.reason": {
          "type": "object",
          "scope": "machine",
          "default": {
            "thinkingLevel": "medium"
          },
          "description": "规划参数。model 可覆盖默认模型；模型密钥通过配置模型命令保存。",
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "object"
            },
            "thinkingLevel": {
              "type": "string",
              "enum": [
                "off",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ],
              "default": "medium"
            },
            "systemPrompt": {
              "type": "string"
            },
            "maxIntents": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "openIntents": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "maxConcurrency": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "maxRounds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "maxRepairs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "maxResponseBytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "ubovm.worker": {
          "type": "object",
          "scope": "machine",
          "default": {},
          "description": "任务执行参数。model 可覆盖默认模型；模型密钥通过配置模型命令保存。",
          "additionalProperties": false,
          "properties": {
            "swarmBackendSelection": {
              "type": "string",
              "enum": [
                "fixed",
                "autonomous"
              ],
              "default": "fixed",
              "description": "并行任务模型选择模式；所有模型统一通过 Pi Agent 调用。"
            },
            "model": {
              "type": "object"
            },
            "thinkingLevel": {
              "type": "string",
              "enum": [
                "off",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            },
            "systemPrompt": {
              "type": "string"
            },
            "maxModelCalls": {
              "type": "integer",
              "minimum": 0,
              "description": "调用次数上限，0 表示不限次数（默认）。"
            },
            "maxToolCalls": {
              "type": "integer",
              "minimum": 0,
              "description": "调用次数上限，0 表示不限次数（默认）。"
            },
            "maxPlanSteps": {
              "type": "integer",
              "minimum": 1
            },
            "maxResponseBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maxCheckpointBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maxToolResultBytes": {
              "type": "integer",
              "minimum": 1
            },
            "requireToolApproval": {
              "type": "boolean",
              "default": true,
              "description": "协助模式下所有工具调用（含子 Worker）执行前须人工审核。关闭后从下一轮对话自动执行。"
            }
          }
        },
        "ubovm.contextSummary": {
          "type": [
            "object",
            "boolean"
          ],
          "scope": "machine",
          "default": true,
          "description": "上下文摘要默认开启，使用规划模型；false 关闭。可设置 model、triggerTokens、targetTokens、keepRecentMessages、maxSummaryTokens、maxSummaryCalls、timeoutMs。",
          "properties": {
            "model": {
              "type": "object"
            },
            "triggerTokens": {
              "type": "integer",
              "minimum": 1
            },
            "targetTokens": {
              "type": "integer",
              "minimum": 1
            },
            "triggerMessages": {
              "type": "integer",
              "minimum": 1
            },
            "keepRecentMessages": {
              "type": "integer",
              "minimum": 1
            },
            "maxSummaryTokens": {
              "type": "integer",
              "minimum": 1
            },
            "maxSummaryCalls": {
              "type": "integer",
              "minimum": 1
            },
            "maxSummaryCallsPerScope": {
              "type": "integer",
              "minimum": 1
            },
            "maxSummaryInputTokens": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "ubovm.mcp": {
          "type": "object",
          "scope": "machine",
          "default": {
            "servers": []
          },
          "description": "本机配置的 MCP 服务，支持 stdio、streamable_http、sse。只读取用户设置，每个运行独立连接并在结束时释放。",
          "properties": {
            "servers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "transport": {
                    "type": "string",
                    "enum": [
                      "stdio",
                      "streamable_http",
                      "streamable-http",
                      "sse"
                    ]
                  },
                  "enabled": {
                    "type": "boolean",
                    "default": true
                  },
                  "required": {
                    "type": "boolean",
                    "default": true
                  },
                  "command": {
                    "type": "string"
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "cwd": {
                    "type": "string"
                  },
                  "env": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "url": {
                    "type": "string"
                  },
                  "headers": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "tools": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "toolNamePrefix": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "connectTimeoutMs": {
              "type": "integer",
              "minimum": 1
            },
            "callTimeoutMs": {
              "type": "integer",
              "minimum": 1
            },
            "maxResultBytes": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "ubovm.skills": {
          "type": "object",
          "scope": "machine",
          "default": {},
          "description": "仅加载 ~/.ubovm/skills 下的技能。内置技能自动释放到此目录，可配置加载预算。",
          "properties": {
            "allowedSkills": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "maxSkills": {
              "type": "integer",
              "minimum": 1
            },
            "maxSkillBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maxTotalBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maxFiles": {
              "type": "integer",
              "minimum": 1
            },
            "maxActiveBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maxWorkers": {
              "type": "integer",
              "minimum": 1
            },
            "resource": {
              "type": "object"
            },
            "script": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "ubovm.intools": {
          "type": [
            "object",
            "boolean"
          ],
          "scope": "machine",
          "default": {},
          "description": "内置工具全部默认启用；保留 SSH、网络搜索等连接参数。旧开关与工具白名单不再限制桌面工具。",
          "properties": {
            "python": {
              "type": [
                "object",
                "boolean"
              ],
              "description": "本地 Python 沙箱，首次 Windows 初始化请运行 UBOVM: 初始化 Python 沙箱。",
              "properties": {
                "executable": {
                  "type": "string",
                  "description": "Python 解释器绝对路径；留空优先使用 IDE 内置 Python，开发环境缺失内置运行时时才查找 PATH。"
                },
                "allowedDomains": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": [
                    "*"
                  ]
                },
                "allowWorkspaceWrite": {
                  "type": "boolean",
                  "default": false
                },
                "defaultTimeoutSeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3600,
                  "default": 120
                },
                "maxTimeoutSeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3600,
                  "default": 600
                },
                "maxOutputBytes": {
                  "type": "integer",
                  "minimum": 1024,
                  "maximum": 10485760,
                  "default": 1048576
                }
              },
              "additionalProperties": false
            },
            "browser": {
              "type": [
                "object",
                "boolean"
              ]
            },
            "ssh": {
              "type": "object"
            },
            "webSearch": {
              "type": [
                "object",
                "boolean"
              ]
            },
            "fetchContent": {
              "type": [
                "object",
                "boolean"
              ]
            },
            "target": {
              "type": "string"
            },
            "canPromote": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "ubovm.summaryEnabled": {
          "type": "boolean",
          "scope": "machine",
          "default": true,
          "description": "启用上下文摘要，关闭时保留已配置的摘要参数。"
        }
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "ubovm-sessions",
          "title": "%view.sessions%",
          "icon": "media/icon.svg"
        }
      ],
      "activitybar": [
        {
          "id": "ubovm-workers",
          "title": "%view.workerLogs%",
          "icon": "media/icon.svg"
        },
        {
          "id": "ubovm-blackboard",
          "title": "%view.blackboard%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ubovm-workers": [
        {
          "type": "webview",
          "id": "ubovm.workerLogs",
          "name": "%view.workerLogs%",
          "contextualTitle": "%view.workerLogs%"
        }
      ],
      "ubovm-sessions": [
        {
          "id": "ubovm.sessions",
          "name": "%view.projects%",
          "contextualTitle": "%view.projects%"
        }
      ],
      "ubovm-blackboard": [
        {
          "type": "webview",
          "id": "ubovm.blackboardDetails",
          "name": "%view.blackboard%",
          "contextualTitle": "%view.blackboard%"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "ubovm.expandFileEditor",
          "when": "!editorPartMaximizedEditorGroup && multipleEditorGroups && activeEditor != mainThreadWebview-ubovm.welcome && activeEditor != mainThreadWebview-ubovm.conversation",
          "group": "navigation@-100"
        },
        {
          "command": "ubovm.restoreFileEditor",
          "when": "editorPartMaximizedEditorGroup",
          "group": "navigation@-100"
        }
      ],
      "editor/context": [
        {
          "command": "ubovm.attachSelection",
          "when": "editorHasSelection && (resourceScheme == file || resourceScheme == untitled || resourceScheme == ubovm-diff)",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "workbench.files.action.refreshFilesExplorer",
          "group": "navigation@90"
        }
      ],
      "view/item/context": [
        {
          "command": "ubovm.deleteConversation",
          "when": "view == ubovm.sessions && !ubovm.settingsPage && (viewItem == ubovm.conversation || viewItem == ubovm.currentConversation)",
          "group": "inline@1"
        },
        {
          "command": "ubovm.deleteConversation",
          "when": "view == ubovm.sessions && !ubovm.settingsPage && (viewItem == ubovm.conversation || viewItem == ubovm.currentConversation)",
          "group": "9_delete"
        },
        {
          "command": "ubovm.newProjectConversation",
          "when": "view == ubovm.sessions && viewItem == ubovm.project",
          "group": "inline@1"
        },
        {
          "command": "ubovm.renameProject",
          "when": "view == ubovm.sessions && viewItem == ubovm.project",
          "group": "navigation@2"
        },
        {
          "command": "ubovm.changeProjectWorkspace",
          "when": "view == ubovm.sessions && !ubovm.settingsPage && viewItem == ubovm.project",
          "group": "navigation@3"
        },
        {
          "command": "ubovm.newProject",
          "when": "view == ubovm.sessions && !ubovm.settingsPage && viewItem == ubovm.project",
          "group": "navigation@4"
        },
        {
          "command": "ubovm.deleteProject",
          "when": "view == ubovm.sessions && !ubovm.settingsPage && viewItem == ubovm.project",
          "group": "inline@2"
        },
        {
          "command": "ubovm.deleteProject",
          "when": "view == ubovm.sessions && !ubovm.settingsPage && viewItem == ubovm.project",
          "group": "9_delete"
        }
      ],
      "view/title": [
        {
          "command": "ubovm.openBrowser",
          "when": "view == workbench.explorer.fileView || view == workbench.explorer.emptyView",
          "group": "navigation@0"
        },
        {
          "command": "ubovm.manageProjects",
          "when": "view == ubovm.sessions && !ubovm.settingsPage",
          "group": "navigation@-1"
        },
        {
          "command": "ubovm.newProject",
          "when": "view == ubovm.sessions && !ubovm.settingsPage",
          "group": "navigation@0"
        },
        {
          "command": "workbench.action.quickOpen",
          "when": "view == workbench.explorer.fileView",
          "group": "navigation@1"
        },
        {
          "command": "workbench.action.findInFiles",
          "when": "view == workbench.explorer.fileView",
          "group": "navigation@2"
        },
        {
          "command": "workbench.action.replaceInFiles",
          "when": "view == workbench.explorer.fileView",
          "group": "navigation@3"
        },
        {
          "command": "ubovm.openTerminal",
          "when": "view == terminal",
          "group": "navigation@2"
        },
        {
          "command": "ubovm.openLocalTerminal",
          "when": "view == terminal",
          "group": "navigation@1"
        },
        {
          "command": "ubovm.selectTerminal",
          "when": "view == terminal",
          "group": "navigation@3"
        },
        {
          "command": "ubovm.searchConversations",
          "when": "view == ubovm.sessions && !ubovm.settingsPage",
          "group": "navigation@1"
        },
        {
          "command": "ubovm.hideSessions",
          "when": "view == ubovm.sessions",
          "group": "navigation@4"
        },
        {
          "command": "ubovm.hideFiles",
          "when": "view == workbench.explorer.fileView || view == workbench.explorer.emptyView",
          "group": "navigation@99"
        },
        {
          "submenu": "ubovm.create",
          "when": "view == ubovm.sessions && !ubovm.settingsPage",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "ubovm.newProjectConversation",
          "when": "false"
        },
        {
          "command": "ubovm.renameProject",
          "when": "false"
        },
        {
          "command": "ubovm.deleteProject",
          "when": "false"
        },
        {
          "command": "ubovm.reviewCodeChanges",
          "when": "ubovm.mode == assist"
        },
        {
          "command": "ubovm.deleteConversation",
          "when": "false"
        },
        {
          "command": "ubovm.newGoal",
          "when": "ubovm.mode == goal"
        },
        {
          "command": "ubovm.selectConversation",
          "when": "false"
        }
      ],
      "ubovm.create": [
        {
          "command": "ubovm.newChat",
          "when": "view == ubovm.sessions && ubovm.mode != goal && !ubovm.settingsPage",
          "group": "1_chat@1"
        },
        {
          "command": "ubovm.newGoal",
          "when": "view == ubovm.sessions && ubovm.mode == goal && !ubovm.settingsPage",
          "group": "1_chat@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ubovm.attachSelection",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "ubovm.openBrowser",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b"
      },
      {
        "command": "ubovm.openAssistant",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "!terminalFocus && activeEditor != 'workbench.editor.browser'"
      },
      {
        "command": "ubovm.newChat",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "!terminalFocus && activeEditor != 'workbench.editor.browser'"
      }
    ],
    "themes": [
      {
        "id": "UBOVM Dark",
        "label": "UBOVM Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/ubovm-dark.json"
      },
      {
        "id": "UBOVM Light",
        "label": "UBOVM Light",
        "uiTheme": "vs",
        "path": "./themes/ubovm-light.json"
      }
    ],
    "viewsWelcome": [
      {
        "view": "ubovm.sessions",
        "when": "ubovm.mode != goal",
        "contents": "$(comment-discussion)\n还没有会话\n从一个问题开始。\n[开始对话](command:ubovm.openAssistant)"
      },
      {
        "view": "ubovm.sessions",
        "when": "ubovm.mode == goal",
        "contents": "$(target)\n还没有探索\n从已知事实定义目标。\n[开始探索](command:ubovm.openAssistant)"
      }
    ],
    "submenus": [
      {
        "id": "ubovm.create",
        "label": "新建",
        "icon": "$(add)"
      }
    ]
  }
}
